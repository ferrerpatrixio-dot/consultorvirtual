# ─────────────────────────────────────────────────────────────
# Generador BPMN — variables de entorno (copiar a .env.local)
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# BASE DE DATOS
# ─────────────────────────────────────────────────────────────

# Mismo proyecto Supabase (misma base Postgres) que sistemaaiprocess —
# decisión de Patricio, 2026-08-04, para no duplicar infraestructura. La
# cadena de conexión es la MISMA que usa sistemaaiprocess/.env; no hace falta
# crear un proyecto Supabase nuevo ni una base separada.
#
# Lo que SÍ es distinto: las tablas de este producto (User/Account/Session/
# VerificationToken/Diagram) viven en el schema Postgres `generador_bpmn`,
# no en `public` (ver prisma/schema.prisma, "schemas" + "@@schema"). Esto
# evita que choquen con las tablas del mismo nombre que sistemaaiprocess ya
# tiene en `public` — son productos sin relación entre sí que no deben
# compartir datos ni tablas, solo el servidor Postgres físico.
DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# ─────────────────────────────────────────────────────────────
# AUTENTICACIÓN
# ─────────────────────────────────────────────────────────────

# Auth.js (NextAuth). Generar con: npx auth secret
AUTH_SECRET="reemplazar-por-un-secreto-largo"

# Google OAuth (Google Cloud Console → Credenciales)
# Redirect URI (dev): http://localhost:3000/api/auth/callback/google
# Redirect URI (prod): https://tu-dominio/api/auth/callback/google
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID="tu-google-client-id"
AUTH_GOOGLE_SECRET="tu-google-client-secret"

# ─────────────────────────────────────────────────────────────
# IA (Fase 2 — motor prompt→JSON)
# ─────────────────────────────────────────────────────────────

# Claude API (Anthropic). https://console.anthropic.com/
# Sin esto, /diagramas/nuevo-ia falla con un mensaje legible (no genera).
ANTHROPIC_API_KEY="sk-ant-..."

# Opcional — modelo a usar (mismo patrón que sistemaaiprocess). Por defecto: claude-sonnet-5.
# CLAUDE_MODEL="claude-sonnet-5"

# ─────────────────────────────────────────────────────────────
# MERCADO PAGO (Fase 5 — suscripción)
# ─────────────────────────────────────────────────────────────

# Panel de Mercado Pago Developers → Tus integraciones → tu app →
# Credenciales. Público = frontend (CardForm), Access Token = backend
# (secreto, nunca en el cliente).
MERCADOPAGO_PUBLIC_KEY="TEST-..."
MERCADOPAGO_ACCESS_TOKEN="TEST-..."

# Se genera UNA sola vez con: node --env-file=.env.local scripts/bootstrap-mercadopago-plan.mjs
# (ver ese script — se niega a correr si esta variable ya está seteada).
MERCADOPAGO_PREAPPROVAL_PLAN_ID=""

# URL de retorno tras autorizar el pago. Mercado Pago exige https válido
# (rechaza http://localhost con 400) — usar un dominio real o un túnel
# (ngrok/similar) en desarrollo si hace falta probar el flujo completo.
MERCADOPAGO_BACK_URL="https://tu-dominio/suscripcion"

# Secreto de verificación de webhooks (panel → Webhooks → "Firma secreta").
# Sin esto, el endpoint de webhooks procesa notificaciones sin verificar
# firma — ver src/app/api/webhooks/mercadopago/route.ts.
# MERCADOPAGO_WEBHOOK_SECRET=""

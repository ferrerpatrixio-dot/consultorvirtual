// Generador BPMN — esquema de datos (PostgreSQL)
// Fase 1: Auth.js (modelos estándar del adapter) + persistencia de diagramas.
// Mono-usuario: cada Diagram pertenece a un solo userId, sin modelo de
// equipo/tenant (decisión de Patricio, ver docs/PROPUESTA-ARQUITECTO-BPMN-DESDE-PROMPT.md).
//
// Schema Postgres aislado: este producto comparte el MISMO proyecto Supabase
// que sistemaaiprocess (decisión de Patricio, 2026-08-04), pero
// sistemaaiprocess usa el schema `public` con tablas `User`/`Account`/
// `Session`/`VerificationToken` sin @@schema. Si generador-bpmn creara las
// mismas tablas también en `public`, chocarían con las de sistemaaiprocess
// (incluso con nombres iguales para entidades sin relación). Por eso todos
// los modelos de acá viven en su propio schema Postgres `generador_bpmn`
// dentro de la misma base, vía el feature `multiSchema` de Prisma (GA desde
// 6.7, ya no requiere declararse en `previewFeatures`).
generator client {
  provider = "prisma-client-js"
  // multiSchema ya no requiere previewFeatures en Prisma 6.19 (GA) —
  // declararlo genera un warning de "deprecated preview feature".
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["generador_bpmn"]
}

// ─────────────────────────────────────────────────────────────
// Auth.js (NextAuth) — modelos estándar del adaptador Prisma
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // Fase 5 — suscripción Mercado Pago ("Suscripciones con plan asociado",
  // ver docs/SPIKE-MERCADO-PAGO-BPMN-DESDE-PROMPT.md). El plan
  // (preapproval_plan_id) es único para toda la app y vive en
  // MERCADOPAGO_PREAPPROVAL_PLAN_ID (env), no en este modelo — no hay tiers.
  // subscriptionStatus refleja 1:1 el campo "status" que devuelve la API de
  // Mercado Pago para un preapproval: "pending" | "authorized" | "paused" |
  // "cancelled". null = todavía no intentó suscribirse.
  subscriptionStatus       String?
  mercadopagoPreapprovalId String? @unique

  // Free Trial de 3 días (ver docs/VIABILIDAD-PRODUCT-MANAGER-BPMN-DESDE-PROMPT.md
  // sección 8): el vencimiento del trial se calcula al vuelo como
  // createdAt + 3 días (no hace falta columna propia). Este contador sí es
  // una columna propia porque el cupo es "1 diagrama en total, para
  // siempre" — contar en vivo los Diagram existentes se rompe si el usuario
  // borra su diagrama (eliminarDiagramaAction ya existía) y vuelve a crear
  // uno, lo que dispararía otra llamada real a la API de Claude
  // (generarDesdePromptAction). Solo sube, nunca baja. Ver src/lib/trial.ts.
  trialDiagramsCreated Int @default(0)

  // Nivel 1 de F02 (docs/DISENO-NIVELES-1-4-F02.md §2.2): tope propio de
  // generaciones LLM del borrador de Mapa de Valor, separado de
  // trialDiagramsCreated porque son dos recursos con dos costos distintos
  // (ver src/lib/trial.ts). Editar/confirmar el mapa NO incrementa esto.
  trialValueMapsCreated Int @default(0)

  accounts  Account[]
  sessions  Session[]
  diagrams  Diagram[]
  valueMaps ValueMap[]

  @@schema("generador_bpmn")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("generador_bpmn")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("generador_bpmn")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("generador_bpmn")
}

// ─────────────────────────────────────────────────────────────
// Dominio: Diagrama BPMN
// ─────────────────────────────────────────────────────────────

// Diagrama de proceso. Modelo de datos heredado del prototipo
// apps/generador-diagramas.html: actores (carriles) + pasos (nodos), cada
// paso con un tipo (inicio|tarea|sistema|decision|fin_ok|fin_error) y su(s)
// destino(s). actores/pasos se guardan como Json porque en Fase 1 son solo
// persistidos y editados con un formulario simple; el motor de render
// (Mermaid, Fase 2/3) los consume tal cual.
model Diagram {
  id        String   @id @default(cuid())
  userId    String
  cliente   String
  proceso   String
  actores   Json     @default("[]")
  pasos     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Incremento 2 de F02 (docs/DISENO-INCREMENTO-2-F02-DESCOMPOSICION.md §1.2):
  // auto-relación que representa el árbol de descomposición en subprocesos.
  // La fuente de verdad de "este paso abre este subproceso" es
  // Paso.subprocesoDiagramId (src/lib/diagramas.ts) — estas columnas son un
  // índice denormalizado para: borrado en cascada del árbol, breadcrumb sin
  // recorrer JSON, y listar solo diagramas raíz (parentDiagramId: null).
  // Se escriben ambos lados en la misma $transaction (ver
  // descomponerEnSubprocesoAction en src/lib/descomposicion.ts).
  parentDiagramId String?
  parentPasoId    String? // id del Paso "subproceso" del padre que abre este diagrama
  // Sigue siendo "profundidad dentro del árbol de subprocesos" (raíz = 0).
  // NO renumerar para que el Nivel 1 (Mapa de Valor) sea el nivel 1: el
  // nivel metodológico es nivel + 2. Renumerar exige backfill de toda la
  // tabla y revisar TOPE_NIVELES en descomposicion.ts a cambio de estética
  // (docs/DISENO-NIVELES-1-4-F02.md §1.4).
  nivel           Int     @default(0)

  // Nivel 1 de F02 (docs/DISENO-NIVELES-1-4-F02.md §1.2-1.3): de qué Mapa
  // de Valor bajó este diagrama, y a qué macroproceso corresponde. Índice
  // denormalizado — la fuente de verdad del enlace es
  // Macroproceso.diagramId dentro de ValueMap.macroprocesos, mismo criterio
  // que Paso.subprocesoDiagramId vs parentDiagramId arriba. SetNull, NO
  // Cascade: borrar el mapa de valor no puede borrar los procesos que el
  // usuario ya modeló (ciclos de vida opuestos, ver §1.1(a)3 del diseño).
  valueMapId     String?
  macroprocesoId String?

  /// Incremento 3 de F02 (docs/DISENO-INCREMENTO-3-F02.md §2.3): claves de
  /// huecos `pendiente` que el usuario declaró aceptar a sabiendas, para
  /// destrabar la exportación. Array de strings con el formato
  /// `${regla}:${pasoId ?? "-"}` (ver claveHueco en src/lib/completitud.ts).
  /// Nunca contiene huecos `bloqueante` — el server los rechaza (ver
  /// reconocerHuecoAction).
  huecosReconocidos Json @default("[]")

  // Versionado (docs/DISENO-VERSIONADO-F02.md §5.2a): borrado lógico del
  // subárbol de subprocesos. quitarPasoAction ya no hace prisma.diagram.delete
  // sobre el hijo: marca deletedAt en el hijo y todo su subárbol. TODAS las
  // consultas de listado/carga deben filtrar deletedAt: null. Un diagrama con
  // deletedAt != null solo se purga físicamente cuando ninguna DiagramVersion
  // conservada lo referencia (ver poda en src/lib/versionado.ts).
  deletedAt DateTime?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Diagram?         @relation("Descomposicion", fields: [parentDiagramId], references: [id], onDelete: Cascade)
  children Diagram[]        @relation("Descomposicion")
  versions DiagramVersion[]
  valueMap ValueMap?        @relation(fields: [valueMapId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([parentDiagramId])
  @@index([userId, deletedAt])
  @@index([valueMapId])
  @@schema("generador_bpmn")
}

// Nivel 1 de F02 (docs/DISENO-NIVELES-1-4-F02.md §1). Tabla nueva, NO
// Diagram con un "tipo" distinto: ningún consumidor de Diagram (completitud,
// mermaid-render, exportar-bpmn, descomposicion) sirve sobre un mapa de
// valor, la cardinalidad es 1→N diagramas raíz (no la auto-relación 1→1 de
// Diagram), y el onDelete: Cascade de esa auto-relación borraría todos los
// procesos del usuario si el mapa fuera un Diagram padre. Ver razones
// completas en el diseño §1.1.
model ValueMap {
  id      String @id @default(cuid())
  userId  String
  cliente String // la empresa mapeada (mismo campo libre que Diagram.cliente)
  rubro   String // input del usuario; es el ÚNICO insumo del borrador LLM

  /// Alcance declarado del mapa: "empresa" | "unidad" | "sede" (ver ALCANCES
  /// en src/lib/valor.ts). Gobierna qué avisos de revisarMapaValor aplican
  /// (V1/V3/V4 solo con "empresa", §3.3 del diseño). Default "empresa"
  /// porque es el caso mayoritario en PYME.
  alcance String @default("empresa")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Macroprocesos vigentes (los que el usuario editó y confirmó). Fuente
  /// de verdad. Ver macroprocesoSchema en src/lib/valor.ts.
  macroprocesos Json @default("[]")

  /// El borrador que devolvió el LLM, intacto, tal como llegó. Nunca se
  /// sobrescribe con las ediciones del usuario — permite "volver al
  /// borrador" sin gastar otra llamada al LLM y mostrar honestamente qué
  /// propuso la máquina vs. qué puso el usuario.
  borradorLlm Json @default("[]")

  /// null = todavía es borrador (badge "propuesta editable" en toda la UI,
  /// controlado por un `if`, no por texto del prompt). No se puede bajar de
  /// nivel a un macroproceso hasta que esto tenga fecha.
  confirmadoAt DateTime?

  deletedAt DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagrams Diagram[]

  @@index([userId, deletedAt])
  @@schema("generador_bpmn")
}

// Versionado (docs/DISENO-VERSIONADO-F02.md §1.1): snapshot completo del
// estado ANTERIOR a cada mutación de un Diagram ("imagen previa"). Se
// escribe en la misma transacción que la mutación (ver
// src/lib/versionado.ts). Reemplaza a Diagram.pasosBackup, que se elimina.
model DiagramVersion {
  id        String   @id @default(cuid())
  diagramId String
  userId    String // denormalizado: permite autorizar sin join al Diagram
  seq       Int // 1, 2, 3... monotónico por diagrama. Es lo que ve el usuario.
  createdAt DateTime @default(now())

  // Qué operación produjo el estado que ESTA versión reemplazó (etiqueta de UI)
  operacion String // ver OperacionVersion en src/lib/versionado.ts
  detalle   String?

  // Snapshot completo del estado ANTERIOR a la operación (imagen previa)
  actores           Json
  pasos             Json
  huecosReconocidos Json
  cliente           String
  proceso           String

  diagram Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  @@unique([diagramId, seq])
  @@index([diagramId, createdAt])
  @@schema("generador_bpmn")
}

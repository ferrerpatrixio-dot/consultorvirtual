// Generador BPMN — esquema de datos (PostgreSQL)
// Fase 1: Auth.js (modelos estándar del adapter) + persistencia de diagramas.
// Mono-usuario: cada Diagram pertenece a un solo userId, sin modelo de
// equipo/tenant (decisión de Patricio, ver docs/PROPUESTA-ARQUITECTO-BPMN-DESDE-PROMPT.md).
//
// Schema Postgres aislado: este producto comparte el MISMO proyecto Supabase
// que sistemaaiprocess (decisión de Patricio, 2026-08-04), pero
// sistemaaiprocess usa el schema `public` con tablas `User`/`Account`/
// `Session`/`VerificationToken` sin @@schema. Si generador-bpmn creara las
// mismas tablas también en `public`, chocarían con las de sistemaaiprocess
// (incluso con nombres iguales para entidades sin relación). Por eso todos
// los modelos de acá viven en su propio schema Postgres `generador_bpmn`
// dentro de la misma base, vía el feature `multiSchema` de Prisma (GA desde
// 6.7, ya no requiere declararse en `previewFeatures`).
generator client {
  provider = "prisma-client-js"
  // multiSchema ya no requiere previewFeatures en Prisma 6.19 (GA) —
  // declararlo genera un warning de "deprecated preview feature".
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["generador_bpmn"]
}

// ─────────────────────────────────────────────────────────────
// Auth.js (NextAuth) — modelos estándar del adaptador Prisma
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  diagrams Diagram[]

  @@schema("generador_bpmn")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("generador_bpmn")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("generador_bpmn")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("generador_bpmn")
}

// ─────────────────────────────────────────────────────────────
// Dominio: Diagrama BPMN
// ─────────────────────────────────────────────────────────────

// Diagrama de proceso. Modelo de datos heredado del prototipo
// apps/generador-diagramas.html: actores (carriles) + pasos (nodos), cada
// paso con un tipo (inicio|tarea|sistema|decision|fin_ok|fin_error) y su(s)
// destino(s). actores/pasos se guardan como Json porque en Fase 1 son solo
// persistidos y editados con un formulario simple; el motor de render
// (Mermaid, Fase 2/3) los consume tal cual.
model Diagram {
  id        String   @id @default(cuid())
  userId    String
  cliente   String
  proceso   String
  actores   Json     @default("[]")
  pasos     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("generador_bpmn")
}
